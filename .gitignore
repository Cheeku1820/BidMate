node_modules
dist
.DS_Store
*.local
.vite
.superpowers
api/.env
api/.env.*
!api/.env.example

# local engine dev venv
.enginevenv/
__pycache__/
*.pyc
.venv/
api/.venv/

# Real contractor bid sets. NDA'd drawings -- bid confidentiality rules
# committing them out (ROADMAP.md 3.3), and two of the archives exceed
# GitHub's 100 MB file cap regardless. They are distributed instead
# through an access-controlled bucket: `scripts/corpus.py fetch` pulls
# them in, verified against the committed digests in
# scripts/corpus-manifest.json. The engine regression tests read from
# here via api/tests/bid_set.py.
bid_examples/

# Archives staged by scripts/corpus.py on their way to or from the bucket.
.corpus-cache/

# Root .env: docker compose reads it for ${ANTHROPIC_API_KEY:-} and the
# like. It carries a real key, so it never lands in the repo.
.env

# Feature worktrees (superpowers:using-git-worktrees)
.worktrees/

# Local port override: bidmate_rebuild owns host port 5432, this repo uses 5433.
docker-compose.override.yml
